# Google PageSpeed Insights
PAGESPEED_API_KEY=your_key_here

# ipinfo.io
IPINFO_TOKEN=your_token_here

# WPScan (25 req/day gratis)
WPSCAN_API_KEY=your_key_here

# Anthropic (para generación de email con Claude)
ANTHROPIC_API_KEY=your_key_here

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Rate limiting (análisis por IP por día)
RATE_LIMIT_PER_DAY=5

# CORS: orígenes permitidos separados por coma. Dejar vacío = permitir todos (solo para desarrollo)
# Ejemplo producción: ALLOWED_ORIGINS=https://analyzer.eclypsedesign.com
ALLOWED_ORIGINS=

# Modelo de Claude para generación de emails
ANTHROPIC_MODEL=claude-sonnet-4-6

# Cache TTL en segundos (24 horas)
CACHE_TTL=86400

# Directorio para guardar PDFs generados
PDF_OUTPUT_DIR=./pdfs
